# Python Runtime & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
env/
venv/
ENV/

# Authentication & Sensitive Browser Data (Playwright Session Cookies)
auth.json
auth_*.json
browser_profile/*
