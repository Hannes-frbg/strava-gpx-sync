# Personal Activity Files (Never leak private routes / home address!)
downloads/*
!downloads/.gitkeep

# Vector Databases & SQLite Stores
*.db
*.sqlite
*.sqlite3

# Environment Variables & API Secrets
.env
*.env
.env.*
!.env.example

# IDEs & Editor Swaps
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Logs
*.log
logs/
